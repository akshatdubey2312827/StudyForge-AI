# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Requires a replica set for transaction support:
# Option A (Local single-node replica set): mongodb://localhost:27017/studyforge?replicaSet=rs0
# Option B (MongoDB Atlas free cluster): mongodb+srv://<user>:<password>@cluster0.mongodb.net/studyforge?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/studyforge?replicaSet=rs0

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6380

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_64_byte_hex_secret
JWT_REFRESH_SECRET=replace_with_different_64_byte_hex_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# ── Stripe ────────────────────────────────────────────────────────────────────
# Test keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# Webhook secret from: stripe listen --forward-to localhost:3001/api/billing/webhook
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_PRICE_STARTER=price_your_starter_price_id
STRIPE_PRICE_PRO=price_your_pro_price_id
STRIPE_PRICE_UNLIMITED=price_your_unlimited_price_id

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Create at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_TIMEOUT_MS=30000

# ── Rate limiting ─────────────────────────────────────────────────────────────
GENERATE_RATE_LIMIT_WINDOW_MS=900000
GENERATE_RATE_LIMIT_MAX=10

# ── Credits ───────────────────────────────────────────────────────────────────
CREDITS_PER_NOTE=2
CREDITS_STARTER_PACK=50
CREDITS_PRO_PACK=150
CREDITS_UNLIMITED_PACK=500
